# =============================================================================
# hermes-9router-stb-installer — environment configuration
#
# Copy this file to .env and fill in the values, then run ./install.sh.
# =============================================================================

# RAM threshold (in MB) below which install.sh creates a swapfile automatically.
# Override with --no-swap on the CLI to skip regardless of this value.
SWAP_THRESHOLD_MB=2048

# Hermes Agent mode: "full" (all 40+ tools) or "lite" (chat-focused, disables
# browser/vision/image_gen/video_gen/tts/computer_use — see config/hermes-config.yaml.template)
HERMES_MODE=lite

# Long random secret for session/JWT signing. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Dashboard admin password used for the initial login (POST /api/auth/login).
# Change this from the default before exposing the dashboard beyond localhost.
INITIAL_PASSWORD=change-me

# Where 9Router stores its SQLite database inside the container.
DATA_DIR=/app/data

PORT=20128
NODE_ENV=production

# Secret used to sign/validate the OpenAI-compatible endpoint proxy auth.
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt

# NOTE: 9Router's "require API key" switch is a DATABASE setting that defaults
# to TRUE — a REQUIRE_API_KEY env var is NOT read by 9router (verified in
# source and by live test). The installer therefore creates an API key for
# Hermes automatically and stores it below. Leave blank on first install.
NINE_ROUTER_API_KEY=

BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# This installer does NOT assume which provider(s) you use. Set up your
# provider connection(s) in the 9Router dashboard FIRST
# (http://<device-ip>:20128/dashboard -> Providers), then list the resulting
# model id(s) below. Two ways to connect a provider there:
#
#   - Built-in provider (NVIDIA NIM, Cloudflare Workers AI, BytePlus, OpenAI,
#     Anthropic, OpenRouter, ...): pick it from the list, paste your API key.
#     Model id format: "<alias>/<model>", e.g.
#       nvidia/deepseek-ai/deepseek-v4-flash
#       cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast     (needs an Account ID)
#       bpm/glm-4-7-251222
#
#   - Custom OpenAI/Anthropic-compatible endpoint (anything else — a local
#     Ollama, a different cloud provider, your own proxy): Providers ->
#     "Add OpenAI Compatible" / "Add Anthropic Compatible", choose your own
#     prefix (e.g. "mycustom") and base URL, then paste the API key.
#     Model id format: "<your-prefix>/<whatever-model-id-that-endpoint-uses>"
#
# IMPORTANT: this file is sourced as a shell script (`. .env`), so an
# unquoted value containing spaces breaks it. No spaces, just commas:
#   NINE_ROUTER_MODELS=nvidia/deepseek-ai/deepseek-v4-flash,cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast
# If you do want spaces for readability, wrap the whole value in double
# quotes instead (confirmed safe: quotes are consumed by the shell, not
# stored in the value):
#   NINE_ROUTER_MODELS="nvidia/deepseek-ai/deepseek-v4-flash, cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast"
NINE_ROUTER_MODELS=

# Only matters if 2+ models are listed above — the combo name that's
# created from them, and what Hermes's model.default gets set to.
NINE_ROUTER_COMBO_NAME=stb-default

# Telegram Bot Token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot.
TELEGRAM_ALLOWED_USERS=

# -----------------------------------------------------------------------------
# HERMES AGENT — dashboard (optional; off by default, see --with-dashboard)
# -----------------------------------------------------------------------------
# HERMES_DASHBOARD=1
# HERMES_DASHBOARD_HOST=127.0.0.1
# HERMES_DASHBOARD_PORT=9119
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
