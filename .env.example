# =============================================================================
# Hermes Agent + 9Router STB Homelab Configuration
# =============================================================================

# Telegram Bot Integration
# Obtain from https://t.me/botfather
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs allowed to interact with the bot
TELEGRAM_ALLOWED_USERS=

# 9Router Gateway Configuration
# Bound to 127.0.0.1 by default for security. Use SSH tunneling to access dashboard.
ROUTER_BIND_HOST=127.0.0.1
ROUTER_PORT=20128
# Secret key for signing dashboard session tokens (minimum 32 characters)
ROUTER_JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
INITIAL_PASSWORD=admin
REQUIRE_API_KEY=false
ROUTER_API_KEY=sk-local-router

# Fallback Combo Name (Hermes Agent will send requests to this combo)
COMBO_NAME=combo-primary

# Model Provider Credentials (BYOK - fill the ones you want configured)
# Upstream Providers
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
BYTEPLUS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Host User Remapping (ensures files created in containers match your host user)
HERMES_UID=1000
HERMES_GID=1000

# Host Data Storage Paths
HERMES_DATA_DIR=~/.hermes
ROUTER_DATA_DIR=~/.9router
